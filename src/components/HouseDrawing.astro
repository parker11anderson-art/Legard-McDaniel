---
// Residential callout drawing: a Mesa ranch house with typical service points.
---
<svg class="drawing" viewBox="0 0 640 380" role="img" aria-labelledby="house-title">
  <title id="house-title">Line drawing of a single-story Mesa ranch house with callouts for panel upgrade, ceiling fan, landscape lighting and EV charger</title>

  <!-- Ground -->
  <line x1="0" y1="300" x2="640" y2="300" stroke="var(--ink)" stroke-width="2" />
  <g stroke="var(--rule)" stroke-width="1">
    <line x1="20" y1="312" x2="80" y2="312" /><line x1="140" y1="316" x2="230" y2="316" />
    <line x1="330" y1="312" x2="420" y2="312" /><line x1="500" y1="318" x2="610" y2="318" />
  </g>

  <!-- Saguaro -->
  <g fill="none" stroke="var(--ink)" stroke-width="2.2" stroke-linecap="round">
    <path d="M58 300 V150 Q58 136 68 136 Q78 136 78 150 V300" />
    <path d="M58 220 H44 Q36 220 36 210 V176 Q36 168 42 168 Q48 168 48 176 V206 H58" />
    <path d="M78 200 H90 Q98 200 98 190 V166 Q98 158 92 158 Q86 158 86 166 V188 H78" />
  </g>

  <!-- House body -->
  <path d="M130 300 V196 H520 V300" fill="var(--paper)" stroke="var(--ink)" stroke-width="2.5" />
  <!-- Roof (low pitch, tile) -->
  <path d="M112 200 L210 148 H452 L540 200 Z" fill="var(--paper-2)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round" />
  <g stroke="var(--ink-3)" stroke-width="1">
    <line x1="140" y1="186" x2="512" y2="186" /><line x1="166" y1="172" x2="488" y2="172" /><line x1="190" y1="159" x2="466" y2="159" />
  </g>

  <!-- Garage -->
  <rect x="380" y="222" width="122" height="78" fill="var(--paper-2)" stroke="var(--ink)" stroke-width="2" />
  <g stroke="var(--ink-3)" stroke-width="1">
    <line x1="380" y1="242" x2="502" y2="242" /><line x1="380" y1="262" x2="502" y2="262" /><line x1="380" y1="282" x2="502" y2="282" />
  </g>

  <!-- Door + windows -->
  <rect x="300" y="226" width="40" height="74" fill="var(--paper-2)" stroke="var(--ink)" stroke-width="2" />
  <rect x="160" y="222" width="72" height="46" fill="var(--blueprint)" stroke="var(--ink)" stroke-width="2" />
  <line x1="196" y1="222" x2="196" y2="268" stroke="var(--ink)" stroke-width="1.5" />
  <!-- Fan visible through window -->
  <g stroke="var(--ink)" stroke-width="1.6">
    <line x1="196" y1="226" x2="196" y2="236" />
    <path d="M176 238 H216" stroke-width="2.4" />
  </g>

  <!-- Panel on side wall -->
  <rect x="140" y="236" width="14" height="24" fill="var(--paper-2)" stroke="var(--ink)" stroke-width="1.8" />
  <line x1="147" y1="236" x2="147" y2="196" stroke="var(--ink)" stroke-width="2" />

  <!-- EV charger -->
  <rect x="508" y="246" width="10" height="18" fill="var(--copper)" stroke="var(--ink)" stroke-width="1.5" />
  <path d="M513 264 Q520 292 548 296" fill="none" stroke="var(--ink)" stroke-width="1.8" />

  <!-- Path lights -->
  <g>
    <line x1="266" y1="300" x2="266" y2="286" stroke="var(--ink)" stroke-width="2" />
    <rect x="262" y="280" width="8" height="6" fill="var(--copper)" />
    <line x1="290" y1="300" x2="290" y2="286" stroke="var(--ink)" stroke-width="2" />
    <rect x="286" y="280" width="8" height="6" fill="var(--copper)" />
  </g>

  <!-- Callouts -->
  <g class="callout" fill="none" stroke="var(--ink-2)" stroke-width="1.2">
    <path d="M147 248 L104 96 H24" />
    <path d="M196 238 L250 80 H330" />
    <path d="M278 282 L360 352 H440" />
    <path d="M513 254 L560 110 H630" />
  </g>
  <g fill="var(--copper)">
    <circle cx="147" cy="248" r="4" /><circle cx="196" cy="238" r="4" /><circle cx="278" cy="282" r="4" /><circle cx="513" cy="254" r="4" />
  </g>
  <g class="c-text">
    <text x="24" y="88">PANEL UPGRADE</text>
    <text x="252" y="72">FANS + FIXTURES</text>
    <text x="362" y="344">LANDSCAPE LIGHTING</text>
    <text x="630" y="102" text-anchor="end">EV CHARGER</text>
  </g>
</svg>

<style>
  .drawing {
    width: 100%;
    height: auto;
  }
  .c-text text {
    font-family: var(--font-display);
    font-stretch: 80%;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.12em;
    fill: var(--ink);
  }
</style>
